# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- IBKR ---
# Account ID is optional; if blank the system uses the first managed account.
IBKR_ACCOUNT=

# --- Telegram ---
# Create a bot via @BotFather to get the token.
# Get your chat id by messaging the bot then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# --- Safety ---
# Master switch. Must be exactly "true" to ever route orders to a LIVE account.
# Leave false for paper trading.
LIVE_TRADING=false
