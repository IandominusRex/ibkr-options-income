# Secrets
.env
.env.*
!.env.example
!.env*.example
*.key
*.pem
*.p12
secrets/
# Google service-account keys (GOOGLE_SHEETS_CREDENTIALS_PATH) and other credential JSON
*service-account*.json
*credentials*.json
client_secret*.json

# Operator config: the repo ships config/examples/<name>.yaml; your own copies stay local
# (src/common/config.py falls back to the example when a private file is missing).
config/settings.yaml
config/risk_limits.yaml
config/scoring_weights.yaml
config/universe.yaml
config/spreads.yaml
config/news.yaml

# IBKR statements and exports (account numbers, real trades) — the ledger fixture is the
# only statement-shaped file tracked, under tests/fixtures/
statements/
*_AS_*.csv
*.qfx
*.ofx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Data & logs (local state, never commit)
data/*.db
data/*.db.bak*
data/*.bak*
data/*.db-shm
data/*.db-wal
data/*.lock
data/*.parquet
data/*.sqlite
data/eod_scheduler_state.json
data/watchdog_state.json
data/sentiment_history.json
data/backups/
# Daily credit spreads: the ThetaData cache (licensed market data), exported trade CSVs, the halt switch
data/spreads_bt/
data/spreads_*.csv
data/spreads.halt
logs/*.log
logs/*.log.*
logs/*.out
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Tooling artifacts (temp agent worktrees, Playwright MCP snapshots)
.claude/worktrees/
.playwright-mcp/
.superpowers/

# Google Drive desktop sync staging (this repo lives in a synced folder)
.tmp.driveupload/

# Keep empty dirs tracked
!data/.gitkeep
!logs/.gitkeep

# Node (any level - web/, root, or a stray install from running npm/vite
# outside web/ by mistake)
node_modules/

# Web (Next.js)
web/.next
web/.env.local
web/.env*.local
web/out
